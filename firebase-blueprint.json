{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile for storing owner identity.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "displayName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "User display name."
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254,
          "description": "Verified user email address."
        },
        "photoURL": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40000,
          "description": "Profile avatar URL or compressed data URI."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["uid", "displayName", "email", "photoURL", "createdAt", "updatedAt"]
    },
    "CodeSnippet": {
      "title": "CodeSnippet",
      "description": "Saved HTML, CSS, JavaScript, or Python project owned by a specific user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique snippet identifier."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the user who owns this snippet."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Project title."
        },
        "mode": {
          "type": "string",
          "enum": ["web", "python"],
          "description": "Project language mode (web or python)."
        },
        "webTabs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "enum": ["html", "css", "js"]
          },
          "description": "Active web language tabs included in this project."
        },
        "html": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200000,
          "description": "HTML source code."
        },
        "css": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200000,
          "description": "CSS source code."
        },
        "js": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200000,
          "description": "JavaScript source code."
        },
        "python": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200000,
          "description": "Python source code."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["id", "ownerId", "title", "html", "css", "js", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private user profile documents isolated per authenticated owner."
    },
    "/users/{userId}/snippets/{snippetId}": {
      "schema": {
        "$ref": "#/entities/CodeSnippet"
      },
      "description": "Private saved HTML, CSS, and JS snippets belonging to a single user."
    }
  }
}
